            "typenames": "VISOR2D:v_montes",
            "outputformat": "application\\/json",
            "propertyname": "shape,denominacion,num_mup",
            "cql_filter": "INTERSECTS\\(shape,SRID=25830;MULTIPOLYGON\\([0-9 .,()-]+\\)\\) AND mup='True'",
            "srsname": "EPSG:25830"
          }
        },
