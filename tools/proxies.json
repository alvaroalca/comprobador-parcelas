            "srsname": "EPSG:25830"
          }
        },
        {
          "tipo": "application/json",
          "params": {
            "service": "WFS",
            "version": "2\\.0\\.0",
            "request": "GetFeature",
            "typenames": "(?:VISOR2D:LIC_ES24|VISOR2D:v108_ps_zepa_es24_s)",
            "outputformat": "application\\/json",
            "propertyname": "shape,sitename",
            "cql_filter": "INTERSECTS\\(shape,SRID=25830;MULTIPOLYGON\\([0-9 .,()-]+\\)\\)",
            "srsname": "EPSG:25830"
          }
        }
