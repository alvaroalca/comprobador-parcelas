          "tipo": "application/json",
          "params": {
            "service": "WFS",
            "version": "2\\.0\\.0",
            "request": "GetFeature",
            "typenames": "SIT_USU_PLA_URB_CARM:clases_plu_ze_37mun",
            "outputformat": "application\\/json",
            "propertyname": "geom,Clasificacion,Municipio,Ambito,Sistema_general,Area_suspendida,Enlace_ficha",
            "cql_filter": "INTERSECTS\\(geom,SRID=25830;MULTIPOLYGON\\([0-9 .,()-]+\\)\\)"
          }
        }
      ],
      "/geoserver/SIT_USU_PLA_URB_CARM/wms": [
        {
          "tipo": "image/png",
          "params": {
            "service": "WMS",
            "version": "1\\.1\\.1",
            "request": "GetMap",
            "layers": "clases_plu_ze_37mun",
            "styles": "",
            "format": "image\\/png",
            "transparent": "true",
            "srs": "EPSG:3857",
            "width": "256",
            "height": "256",
            "bbox": "-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?"
          }
        }
      ]
    }
  },
