{
  "_": "Proxies del mismo origen para los servicios sin CORS válido. Lo leen tools/servir.py y, copiado, el Worker del portfolio (src/parcelas-proxies.json): solo pasa una petición cuyos parámetros (nombres sin mayúsculas, ninguno repetido ni de más) casen enteros con los patrones de una de las formas de su ruta, y su respuesta tiene que ser del tipo de esa forma. Si la página cambia sus peticiones, se cambia aquí y se vuelve a copiar.",
  "/api/miteco/": {
    "servidor": "https://gis.miteco.gob.es",
    "rutas": {
      "/geoserver/agua/wfs": [
        {
          "tipo": "application/json",
          "params": {
            "service": "WFS",
            "version": "2\\.0\\.0",
            "request": "GetFeature",
            "typenames": "(?:agua:ZI_Laminas_ZFP|agua:Zi_laminas_q500|agua:DPH_Estimado|agua:DPH_Deslindado)",
            "outputformat": "application\\/json",
            "propertyname": "rio,tipo_zona",
            "cql_filter": "BBOX\\(shape,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,'EPSG:4326'\\)"
          }
        }
      ],
      "/geoserver/agua/wms": [
        {
          "tipo": "image/png",
          "params": {
            "service": "WMS",
            "version": "1\\.1\\.1",
            "request": "GetMap",
            "layers": "(?:agua:ZI_Laminas_ZFP|agua:Zi_laminas_q500|agua:DPH_Estimado|agua:DPH_Deslindado)",
            "styles": "",
            "featureid": "[\\w.]+(?:,[\\w.]+)*",
            "srs": "EPSG:25830",
            "bbox": "-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?",
            "width": "(?:[1-9]\\d{0,2}|10[01]\\d|102[0-4])",
            "height": "(?:[1-9]\\d{0,2}|10[01]\\d|102[0-4])",
            "format": "image\\/png",
            "transparent": "true",
            "sld_body": "<StyledLayerDescriptor version=\"1\\.0\\.0\" xmlns=\"http:\\/\\/www\\.opengis\\.net\\/sld\"><NamedLayer><Name>(?:agua:ZI_Laminas_ZFP|agua:Zi_laminas_q500|agua:DPH_Estimado|agua:DPH_Deslindado)<\\/Name><UserStyle><FeatureTypeStyle><Rule><PolygonSymbolizer><Fill><CssParameter name=\"fill\">#000000<\\/CssParameter><\\/Fill><\\/PolygonSymbolizer><\\/Rule><\\/FeatureTypeStyle><\\/UserStyle><\\/NamedLayer><\\/StyledLayerDescriptor>"
          }
        }
      ]
    }
  },
  "/api/carm/": {
